  "naming": {
    "template": "{first_author}-{year}-{short_title}",
    "dir_template": "library/{project}/{doc_type}/{year}",
    "max_len": 120,
    "fallback_order": [
      "{first_author}-{year}-{short_title}",
      "{first_author}-{year}-{identifier_tail}",
      "{year}-{short_title}",
      "{identifier_tail}",
      "{original_stem}_unresolved"
    ],
    "char_map": {
      "\\": "-",
      "/": "-",
      ":": "-",
      "*": "",
      "?": "",
      "\"": "",
      "<": "",
      ">": "",
      "|": "-",
      "\n": " ",
      "\t": " ",
      "　": " "
    },
    "space_to": "_",
    "strip_chars": " ._-",
    "dup_suffix": "_dup",
    "short_title_words": 4
  },
  "reconciliation": {
    "min_title_tokens": 3,
    "title_similarity": 0.86,
