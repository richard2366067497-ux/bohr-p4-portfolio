{
  "version": "1.0.0",
  "description": "面元目录（facet catalog）默认规格。案例若在 case.json 里给出 facet_spec/facets/naming_template 等字段，则以案例为准，覆盖项会写入 degradations:config_override。本文件不含任何具体案例的答案，只定义判定规则、受控词表与渲染/命名策略。",
  "facets": [
    {
      "facet": "project",
      "definition": "该资料在资料库中归属的项目/课题分组；优先取输入库的顶层目录名或案例给出的项目映射，取不到记 _unassigned。",
      "allowed_values": null,
      "pattern": null,
      "rule": "path_priority: 案例 project_map > 相对路径第 1 段目录 > case.json 的 project 字段 > _unassigned；无路径证据时可作为整理者的分组判断（evidence_kind=path_or_judgment）",
      "multi": false,
      "sources_priority": [
        "case_config",
        "path",
        "companion_metadata"
      ],
      "from_path_segment": 0,
      "evidence_kind": "path_or_judgment"
    },
    {
      "facet": "doc_type",
      "definition": "文献/资料的体裁：期刊论文、预印本、会议论文、学位论文、补充材料、数据集、扫描件或未知。判定依据是正文中的体裁标记词，不是文件名猜测。",
      "allowed_values": [
        "article",
        "preprint",
        "conference",
        "thesis",
        "supplement",
        "dataset",
        "scan",
        "unknown"
      ],
      "pattern": null,
      "rule": "按 doc_type_markers 的优先级（supplement > thesis > conference > dataset > preprint > article）匹配正文；命中记 marker 与 quote；无命中且 text_layer=no_text_layer 记 scan；其余 unknown。",
      "multi": false,
      "sources_priority": [
        "document_text",
        "companion_metadata",
        "filename",
        "path"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "year",
      "definition": "该资料的出版/发布年份（四位数字）。预印本取其发布年份，正式版取期刊年份。",
      "allowed_values": null,
      "pattern": "^(19[5-9]\\d|20[0-4]\\d)$",
      "rule": "优先取伴随元数据表 year 列；否则取正文中与 published/accepted/copyright/© 邻近的年份；再否则取正文首个 19xx/20xx。无证据记 null 并进 unresolved。禁止推算。",
      "multi": false,
      "sources_priority": [
        "companion_metadata",
        "document_text",
        "filename"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "method",
      "definition": "文献使用的核心研究方法/表征手段，取受控词表（method_keywords）中的值，单文件最多 6 个。",
      "allowed_values": null,
      "pattern": null,
      "rule": "在标题+摘要+方法段文本中匹配 method_keywords 的别名，按出现次数降序取前 6 个；每个值必须能给出命中片段。",
      "multi": true,
      "sources_priority": [
        "document_text",
        "companion_metadata"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "topic",
      "definition": "文献的主题标签，取受控词表（topic_keywords）中的值，用于跨项目检索，单文件最多 6 个。",
      "allowed_values": null,
      "pattern": null,
      "rule": "在标题+摘要文本中匹配 topic_keywords 的别名，按首次出现位置排序取前 6 个；每个值必须给出命中片段。",
      "multi": true,
      "sources_priority": [
        "document_text",
        "companion_metadata"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "source_type",
      "definition": "资料获取渠道：出版商正式版、预印本仓储、数据集仓储、个人扫描、内部共享、未知。",
      "allowed_values": [
        "publisher",
        "repository",
        "data_repository",
        "personal_scan",
        "internal",
        "unknown"
      ],
      "pattern": null,
      "rule": "正文/元数据含 doi.org/elsevier/springer/wiley/acs/ieee/nature.com → publisher；arXiv/bioRxiv/medRxiv/SSRN/ResearchGate → repository；figshare/zenodo/dryad/OSF → data_repository；scan/scanned/扫描 → personal_scan；其余 unknown。",
      "multi": false,
      "sources_priority": [
        "document_text",
        "companion_metadata",
        "filename"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "version_state",
      "definition": "该文件在同一作品版本链中的位置：正式发表版、预印本、作者接受稿、补充材料、修订/勘误版、数据集、未知。",
      "allowed_values": [
        "published",
        "preprint",
        "postprint",
        "supplementary",
        "revision",
        "dataset",
        "unknown"
      ],
      "pattern": null,
      "rule": "含 accepted manuscript/author accepted/postprint → postprint；含 arXiv/bioRxiv/preprint/preprint server → preprint；含 supplementary/supporting information → supplementary；含 erratum/corrigendum/revised version → revision；有期刊卷期或正式 DOI 且无预印本标记 → published；数据集标记 → dataset；其余 unknown。",
      "multi": false,
      "sources_priority": [
        "document_text",
        "companion_metadata",
        "filename"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "language",
      "definition": "正文主要语言，用于命名与检索分组。",
      "allowed_values": [
        "en",
        "zh",
        "other",
        "unknown"
      ],
      "pattern": null,
      "rule": "统计正文 CJK 字符占比 >0.2 → zh；拉丁字母主导 → en；文本不可读 → unknown。",
      "multi": false,
      "sources_priority": [
        "document_text",
        "filename"
      ],
      "evidence_kind": "quote"
    },
    {
      "facet": "identifier",
      "definition": "作品的稳定标识（DOI 或 arXiv id），原样保留大小写与标点，不做补全。",
      "allowed_values": null,
      "pattern": null,
      "rule": "只接受正文/元数据中逐字出现的 DOI 或 arXiv id；取不到记 null，禁止按标题推断 DOI。",
      "multi": false,
      "sources_priority": [
        "document_text",
        "companion_metadata"
      ],
      "evidence_kind": "quote"
    }
  ],
