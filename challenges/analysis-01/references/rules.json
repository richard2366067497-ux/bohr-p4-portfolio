  "numeric_clean": {
    "thousands_pattern": "^[-+]?\\d{1,3}(\\.\\d{3})+(,\\d+)?$",
    "superscripts": {
      "⁰": "0",
      "¹": "1",
      "²": "2",
      "³": "3",
      "⁴": "4",
      "⁵": "5",
      "⁶": "6",
      "⁷": "7",
      "⁸": "8",
      "⁹": "9",
      "⁻": "-",
      "⁺": "+"
    },
    "comparator_prefix": "^(<=|>=|<|>|≤|≥|~|≈|=)\\s*"
  },
  "qc_invariants": [
    "raw_rows == kept_rows + marked_rows + quarantined_rows",
    "sum(ledger.rows_affected for value-changing actions) == count(flags with that action)",
    "report_counts == recount(cleaned_table.__flags)",
    "sha256(source) before == sha256(source) after",
    "no field value replaced where action in {mark_missing, mark_invalid}"
  ],
